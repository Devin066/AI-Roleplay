generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id           String   @id
  email        String   @unique
  name         String
  position     String?
  role         String
  isActive     Boolean  @default(true)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@index([isActive])
  @@index([updatedAt])
}

model RolePlay {
  id                 String   @id
  status             String
  meetingTitle       String
  characterName      String
  characterRole      String
  durationMinutes    Int
  assignedTraineeIds Json
  config             Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  attempts RolePlayAttempt[]

  @@index([status])
  @@index([updatedAt])
}

model TranscriptSession {
  id                  String   @id
  scenarioId          String
  scenarioTitle       String
  status              String
  completedObjectives Json
  transcript          Json
  createdAt           DateTime @default(now())

  @@index([scenarioId])
  @@index([createdAt])
}

model FinalAssessment {
  id                  String   @id
  transcriptSessionId String
  scenarioId          String
  scenarioTitle       String
  learnerId           String?
  learnerName         String?
  learnerEmail        String?
  learnerRole         String?
  overallScore        Int
  outcome             String
  summary             String
  strengths           Json
  improvements        Json
  completedObjectives Json
  missedObjectives    Json
  dimensions          Json
  criticalRisks       Json     @default("[]")
  scoreOverride       Json?
  transcript          Json
  createdAt           DateTime @default(now())

  @@index([transcriptSessionId])
  @@index([scenarioId])
  @@index([createdAt])
}

model RolePlayAttempt {
  id                String   @id @default(cuid())
  userId            String
  rolePlayId        String
  completedAttempts Int      @default(0)
  lastCompletedAt   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  rolePlay RolePlay @relation(fields: [rolePlayId], references: [id], onDelete: Cascade)

  @@unique([userId, rolePlayId])
  @@index([userId])
  @@index([rolePlayId])
}

model FeedbackSubmission {
  id                  String   @id @default(cuid())
  ticketNumber        Int      @unique @default(autoincrement())
  userId              String
  userName            String
  userEmail           String
  title               String
  description         String
  pagePath            String
  category            String   @default("feedback")
  attachmentName      String?
  attachmentMimeType  String?
  attachmentSizeBytes Int?
  attachmentStatus    String?
  status              String   @default("open")
  createdAt           DateTime @default(now())

  comments FeedbackComment[]

  @@index([userId])
  @@index([status, createdAt])
}

model FeedbackComment {
  id                   String   @id @default(cuid())
  feedbackSubmissionId String
  authorId             String
  authorName           String
  authorEmail          String
  body                 String
  kind                 String   @default("comment")
  previousStatus       String?
  newStatus            String?
  createdAt            DateTime @default(now())

  feedbackSubmission FeedbackSubmission @relation(fields: [feedbackSubmissionId], references: [id], onDelete: Cascade)

  @@index([feedbackSubmissionId, createdAt])
}
