# Server-side Agora App ID. The RTC client receives this public identifier only when joining a session.
AGORA_APP_ID=
# Local Postgres.app example:
# DATABASE_URL="postgresql://YOUR_MAC_USERNAME@127.0.0.1:5432/cse_training_partner_local?schema=public"
DATABASE_URL=
AUTH_SESSION_SECRET=
# Optional separate signing secret for the server-only ConvoAI agent control cookie.
# Falls back to AUTH_SESSION_SECRET when unset; set independently for stronger compartmentalization.
CONVOAI_AGENT_SESSION_SECRET=
# WeCom group robot webhook. Set it in your terminal or deployment secret store; never expose it to the browser.
WECOM_FEEDBACK_WEBHOOK_URL=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
CONVOAI_BASE_URL=https://api.agora.io/api/conversational-ai-agent/v2
CONVOAI_ASR_PROVIDER=deepgram
# Live roleplay uses Agora-managed LLM credentials; no LLM key, public proxy, or tunnel is required.
CONVOAI_MANAGED_LLM_MODEL=gpt-4o-mini
CONVOAI_TTS_PROVIDER=minimax
CONVOAI_TTS_URL=wss://api.minimax.io/ws/v1/t2a_v2
CONVOAI_MINIMAX_TTS_MODEL=speech-2.8-turbo
CONVOAI_TTS_SPEED=1
# Optional fallback only. Roleplay AI Character selection normally provides the MiniMax voice ID.
CONVOAI_TTS_VOICE=English_expressive_narrator
OBJECTIVE_EVALUATOR_PROVIDER=oss
OBJECTIVE_EVALUATOR_API_KEY=
OBJECTIVE_EVALUATOR_MODEL=gpt-5.5
OBJECTIVE_EVALUATOR_BASE_URL=https://v2.vexke.com/openai
OBJECTIVE_EVALUATOR_WIRE_API=responses
OBJECTIVE_EVALUATOR_MIN_CONFIDENCE=0.4
FINAL_ASSESSMENT_PROVIDER=oss
FINAL_ASSESSMENT_API_KEY=
FINAL_ASSESSMENT_MODEL=gpt-5.5
FINAL_ASSESSMENT_BASE_URL=https://v2.vexke.com/openai
FINAL_ASSESSMENT_WIRE_API=responses
OSS_API_KEY=
OSS_MODEL=gpt-5.5
OSS_REASONING_EFFORT=high
